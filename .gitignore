# Never commit env files with credentials
# Note: API keys are blocked by pre-commit hook (pattern matching)
# regardless of filename. Use environment variables, never inline credentials.
.env
.env.*

# Client-specific forbidden names list (local only, never tracked)
.forbidden_names
property_history_cache.json
*_cache.json
